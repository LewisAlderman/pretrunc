{
  "name": "pretrunc",
  "version": "0.0.0",
  "description": "Cut text at its start, middle or end to fit a width, measured before it paints, never overflowing",
  "keywords": [
    "canvas",
    "clamp",
    "ellipsis",
    "middle-ellipsis",
    "pretext",
    "react",
    "solid",
    "text",
    "truncate"
  ],
  "homepage": "https://lewisalderman.github.io/pretrunc/",
  "bugs": "https://github.com/LewisAlderman/pretrunc/issues",
  "license": "MIT",
  "author": "Lewis Alderman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LewisAlderman/pretrunc.git"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "DESIGN.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "solid": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "solid": "./src/dom.ts",
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./lines": {
      "solid": "./src/lines.ts",
      "types": "./dist/lines.d.ts",
      "default": "./dist/lines.js"
    },
    "./metrics": {
      "solid": "./src/metrics.ts",
      "types": "./dist/metrics.d.ts",
      "default": "./dist/metrics.js"
    },
    "./solid": {
      "solid": "./src/solid.tsx",
      "types": "./dist/solid.d.ts",
      "default": "./dist/solid.js"
    },
    "./solid/lines": {
      "solid": "./src/solid-lines.tsx",
      "types": "./dist/solid-lines.d.ts",
      "default": "./dist/solid-lines.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react/lines": {
      "types": "./dist/react-lines.d.ts",
      "default": "./dist/react-lines.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "vp config && effect-tsgo patch --oxlint",
    "prepack": "vp run build"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@chenglou/pretext": "1.0.0",
    "@effect/tsgo": "0.53.1",
    "@effect/vitest": "4.0.5",
    "@fontsource-variable/inter": "5.3.0",
    "@shikijs/twoslash": "4.5.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@solidjs/web": "2.0.0-rc.15",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/fontkit": "2.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "5.0.4",
    "effect": "4.0.5",
    "eslint-plugin-solid": "0.18.1",
    "fontkit": "2.0.4",
    "knip": "6.39.0",
    "playwright": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shiki": "4.5.0",
    "solid-js": "2.0.0-rc.15",
    "twoslash": "0.3.9",
    "typescript": "7.0.2",
    "typescript-twoslash": "npm:typescript@5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@chenglou/pretext": "1.0.0",
    "@solidjs/web": "2.0.0-rc.15",
    "react": "^19.0.0",
    "solid-js": "2.0.0-rc.15"
  },
  "peerDependenciesMeta": {
    "@chenglou/pretext": {
      "optional": true
    },
    "@solidjs/web": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.12.0",
      "onFail": "download"
    }
  }
}
